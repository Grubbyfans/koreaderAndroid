<?xml version="1.0" encoding="utf-8"?>
<!--
  WebDAV PROPFIND Depth:0 响应样例（stat 单个条目）。
  用于校准 core/cloud/webdav/DavXml.kt 的解析。

  说明：
  - 命名空间统一使用 DAV:（标准 WebDAV 命名空间）。
  - resourcetype 不含 collection 子元素 => 是文件（非目录）。
  - 这是「文件」条目：library.json。
  脱敏样例，非真实服务器返回。
-->
<D:multistatus xmlns:D="DAV:">
  <D:response>
    <D:href>/dav/books/library.json</D:href>
    <D:propstat>
      <D:prop>
        <D:resourcetype/>
        <D:getcontentlength>2048</D:getcontentlength>
        <D:getetag>"b1946ac9-2f4b-11ee-b6d1-0242ac120002"</D:getetag>
        <D:getlastmodified>Sun, 19 Nov 2026 10:00:00 GMT</D:getlastmodified>
      </D:prop>
      <D:status>HTTP/1.1 200 OK</D:status>
    </D:propstat>
  </D:response>
</D:multistatus>
