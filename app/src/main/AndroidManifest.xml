<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".ReaderApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.YuezhouReader">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.YuezhouReader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 外部 EPUB 打开：同一入口负责导入书架后阅读。 -->
        <activity
            android:name=".OpenEpubActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name"
            android:theme="@style/Theme.YuezhouReader">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.EPUB" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
        </activity>

        <!-- P1 最小阅读闭环 Activity -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.YuezhouReader"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 下载保活前台服务：切后台/锁屏时防止进程被冻结导致下载超时 -->
        <service
            android:name=".DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Z-Library 内置网页容器（阶段 C）：非导出、独立进程。
            Application 进程守卫保证该进程不初始化 Room/同步/TTS；WebView 使用独立数据目录。
        -->
        <activity
            android:name=".web.ZLibraryWebActivity"
            android:exported="false"
            android:process=":zlibraryweb"
            android:launchMode="singleTop"
            android:theme="@style/Theme.YuezhouReader"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Z-Library 网页下载登记（阶段 D）：非导出、只接受同 UID 的 call("watch")。
            不提供查询/写入通道，避免成为通用文件接口；主进程据此观察系统 DownloadManager。
        -->
        <provider
            android:name=".web.ZLibraryDownloadHandoffProvider"
            android:authorities="${applicationId}.zlibrary.web"
            android:exported="false"
            android:grantUriPermissions="false" />
    </application>

</manifest>
