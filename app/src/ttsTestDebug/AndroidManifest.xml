<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".tts.ReaderTtsApplication"
        tools:replace="android:name">
        <activity
            android:name=".webprobe.WebViewStageTwoActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:process=":webprobe"
            android:theme="@style/Theme.YuezhouReader" />
        <!-- 阶段 B 试音入口：通过 ADB 显式启动 -->
        <activity
            android:name=".tts.KokoroTrialActivity"
            android:exported="true"
            android:label="Kokoro 试音"
            android:theme="@style/Theme.YuezhouReader" />

        <!-- 阶段 D 服务验收：启动后销毁 Activity，由前台服务继续跨章朗读 -->
        <activity
            android:name=".tts.StageDActivity"
            android:exported="true"
            android:theme="@style/Theme.YuezhouReader" />

        <!-- 临时 WebView 可行性探针：仅本变体存在，ADB 显式启动，未接入应用内导航 -->
        <activity
            android:name=".webprobe.WebViewProbeActivity"
            android:exported="true"
            android:label="WebView 探针"
            android:theme="@style/Theme.YuezhouReader"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density" />
    </application>

</manifest>
